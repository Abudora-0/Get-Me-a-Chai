# Copy to .env.local for local dev. On the host, set the same keys as
# environment variables. Never commit real values.

# ---- NextAuth / Auth.js ----
# Must exactly match the origin the app is served from. Locally that is
# http://localhost:3000; in production it is the deployed URL with NO
# trailing slash and NO path. If this is wrong, OAuth fails with
# "redirect_uri is not associated" (GitHub) or "redirect_uri_mismatch" (Google).
NEXTAUTH_URL=http://localhost:3000
# Any long random string: `openssl rand -base64 32`
NEXTAUTH_SECRET=your_secret

# ---- GitHub OAuth ----
# https://github.com/settings/developers -> New OAuth App
# Authorization callback URL must be:  <NEXTAUTH_URL>/api/auth/callback/github
# (GitHub OAuth apps allow only ONE callback URL; use a separate app per env.)
GITHUB_ID=your_github_oauth_app_client_id
GITHUB_SECRET=your_github_oauth_app_client_secret

# ---- Google OAuth ----
# https://console.cloud.google.com -> APIs & Services -> Credentials
# Authorized redirect URI must include:  <NEXTAUTH_URL>/api/auth/callback/google
# Authorized JavaScript origin must include:  <NEXTAUTH_URL>
# (Google allows many, so keep both localhost and production entries.)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ---- Database (Prisma / Postgres) ----
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- App ----
NEXT_PUBLIC_URL=http://localhost:3000
